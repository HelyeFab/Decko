rules_version = '2';

// Decko cloud sync (MVP_020, DEC-029). Each signed-in user can read and write
// ONLY their own subtree. Nothing else is exposed. Activity / settings / profile
// live under /users/{uid}/**; review scheduling is never stored in the cloud.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
